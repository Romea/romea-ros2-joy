<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>romea_joystick_meta_bringup</name>
  <version>0.0.0</version>
  <description>Package containing joystick launch files.</description>

  <maintainer email="jean.laneurit@inrae.fr">Jean Laneurit</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>romea_common_meta_bringup</exec_depend>
  <exec_depend>romea_joystick_utils</exec_depend>

  <exec_depend>joy</exec_depend>
  <!-- TODO uncomment pynput when released in ros2 -->
  <!-- <exec_depend>pynput_teleop</exec_depend> -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>joy_linux</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>